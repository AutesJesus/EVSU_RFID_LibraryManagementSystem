<?php

declare(strict_types=1);

/** Copy to db.local.php (local dev) or let CI/CD write it on deploy from GitHub secrets.
 *  Loaded before XAMPP defaults in database.php — overrides apply correctly. */

if (!defined('DB_HOST')) {
    define('DB_HOST', 'localhost');
}
if (!defined('DB_USER')) {
    define('DB_USER', 'u123456789_app');
}
if (!defined('DB_PASS')) {
    define('DB_PASS', 'your_mysql_password');
}
if (!defined('DB_NAME')) {
    define('DB_NAME', 'u123456789_evsu_rfid');
}

/** Set false on Hostinger after creating the database in hPanel. */
if (!defined('DB_AUTO_CREATE')) {
    define('DB_AUTO_CREATE', false);
}
