# EVSU RFID Library — Hostinger / Apache
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
</IfModule>

# Block direct access to config and scripts if document root is the project folder
<IfModule mod_authz_core.c>
    <FilesMatch "^(composer\.(json|lock)|\.gitignore)$">
        Require all denied
    </FilesMatch>
</IfModule>

# php_flag/php_value only work with mod_php; on Hostinger PHP-FPM they cause HTTP 500.
# Set upload limits in hPanel → PHP Configuration if needed.
