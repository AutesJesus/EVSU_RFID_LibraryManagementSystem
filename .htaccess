# EVSU RFID Library — Hostinger / Apache
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
</IfModule>

# Block direct access to config and scripts if document root is the project folder
<IfModule mod_authz_core.c>
    <FilesMatch "^(composer\.(json|lock)|\.gitignore)$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule mod_php.c>
    php_flag display_errors Off
    php_value upload_max_filesize 10M
    php_value post_max_size 12M
</IfModule>
